#!/usr/bin/env bash
# clean-any-ai — Universal multi-AI session cleaner master entrypoint
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# 08-31 fix: installed copies live in ~/.local/bin — the relative PROJECT_ROOT
# then resolves to ~/.local and clean_any.py is never found. Use the profile
# export (DRIFT_CLEAN_HOME) when set; fall back to repo-relative for
# repo-local development runs.
if [ -n "${DRIFT_CLEAN_HOME:-}" ] && [ -d "${DRIFT_CLEAN_HOME}/src/drift_clean" ]; then
  PROJECT_ROOT="$DRIFT_CLEAN_HOME"
else
  PROJECT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
fi

export PYTHONPATH="$PROJECT_ROOT:${PYTHONPATH:-}"
exec python3 "$PROJECT_ROOT/src/drift_clean/clean_any.py" "$@"
